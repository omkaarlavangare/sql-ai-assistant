# Copy this file to ".env" and fill in your real values.
# ".env" itself is git-ignored so your secrets never get committed.

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="Enter Your Claude API Key Here"

# SQLAlchemy connection string for your PostgreSQL database.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
APP_DB_URL="Enter Your PostgreSQL Connection String Here"

# Optional: override the Claude model used for SQL generation + insights.
# Defaults to claude-sonnet-5 if not set.
CLAUDE_MODEL=claude-sonnet-5

# Optional: path for storing evaluation logs for each assistant run.
# Defaults to the project's logs directory if not set.
ASSISTANT_LOG_PATH=./logs/assistant_runs.jsonl
